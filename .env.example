# Copie para .env.local (dev) ou configure na Vercel em
# Project Settings > Environment Variables (producao).
#
# NENHUMA destas pode ganhar o prefixo NEXT_PUBLIC_: esse prefixo embute o
# valor no JavaScript que vai pro navegador, e todas aqui sao segredos.

# URL publica do site. Monta os back_urls e o notification_url do Mercado
# Pago, entao em teste local precisa ser a URL do tunel (ngrok), nao
# localhost — o Mercado Pago nao consegue redirecionar nem notificar
# localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Credenciais do Mercado Pago (Suas integracoes > sua aplicacao).
# Use as de TESTE ate o fluxo estar validado ponta a ponta.
MP_ACCESS_TOKEN=
# "Assinatura secreta" da mesma tela, em Webhooks. Valida que a notificacao
# veio mesmo do Mercado Pago.
MP_WEBHOOK_SECRET=
# Sai de `node scripts/setup-mercadopago.mjs` (plano do Jarvis Mensal).
MP_PREAPPROVAL_PLAN_ID=

# Envio do e-mail de entrega (resend.com).
RESEND_API_KEY=
# Precisa ser de um dominio verificado no Resend.
EMAIL_FROM=Jarvis <contato@seudominio.com.br>

# Chave PRIVADA Ed25519 que assina a licenca — precisa ser o MESMO par cuja
# chave publica esta embutida no app (Jarvis-Developer-Edition/src/main/
# security/license.ts). Vem em base64 (o PEM inteiro codificado, pra nao
# quebrar em variavel de ambiente multi-linha). NUNCA gere um par novo aqui —
# use o par de producao que ja existe em
# Jarvis-Developer-Edition/scripts/.license-keys/private.pem, por exemplo:
#   base64 -w0 scripts/.license-keys/private.pem
# Trocar isso por um par diferente do app invalida TODAS as licencas e exige
# recompilar o app com a chave publica nova.
LICENSE_PRIVATE_KEY_B64=

# Servidor de creditos gerenciados (repo Estus-Corporation/Jarvis-Credits-Server,
# hospedado no Railway) — usado pra conceder o saldo pago junto da licenca.
CREDITS_SERVER_URL=https://jarvis-credits-server-production.up.railway.app
# Precisa ser IDENTICO ao ADMIN_SECRET configurado no servidor de creditos —
# e o segredo compartilhado que autoriza este webhook (e só ele) a conceder
# saldo pago pra qualquer e-mail.
CREDITS_ADMIN_SECRET=

# Link estavel do instalador do Jarvis para Windows, enviado no e-mail.
DOWNLOAD_URL=
