# Copie para .env.local (desenvolvimento) e cadastre os mesmos valores na Vercel
# em Project Settings > Environment Variables (producao).
#
# .env.local e .env estao no .gitignore. NUNCA comite chave de verdade aqui.

# Dominio real do site. Sem isso, URLs canonicas e imagens de OG apontam pra
# localhost. Ver lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Link de convite da Comunidade do WhatsApp, mostrado na tela de sucesso do
# formulario de lista de espera. JA TEM DEFAULT hardcoded em
# components/Formulario.tsx (nao e segredo, e um link feito pra divulgar) —
# so preencha aqui se for TROCAR o link sem esperar um deploy.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# Google Sheets: onde os leads da lista de espera sao gravados.
# Ver app/api/waitlist/route.ts.
#
# Como obter:
#   1. console.cloud.google.com > novo projeto > ativar "Google Sheets API"
#   2. IAM & Admin > Service Accounts > criar conta > Keys > Add key (JSON)
#   3. do JSON baixado: client_email -> abaixo, private_key -> abaixo
#   4. compartilhar a planilha com o client_email, com permissao de Editor
#   5. GOOGLE_SHEET_ID = o trecho entre /d/ e /edit na URL da planilha
#
# GOOGLE_PRIVATE_KEY vai entre aspas, numa linha so, com \n literal nas quebras
# (a rota converte de volta) — e o formato que o painel da Vercel aceita.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=
